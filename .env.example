# Production Web Push subscription API.
VITE_PUSH_API_URL=https://faecherbagger-push.faecherbagger.workers.dev

# Who is responsible for this deployment. Without these the
# Datenschutzerklärung renders a visible warning instead of an invented
# address — a public deployment must set them.
VITE_OPERATOR_NAME=
# Newline-separated postal address (use \n in a .env file).
VITE_OPERATOR_ADDRESS=
VITE_OPERATOR_EMAIL=
