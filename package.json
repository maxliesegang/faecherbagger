{
  "name": "faecherbagger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Understandable view of current and upcoming road construction sites (Baustellen) in the Karlsruhe region.",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p push-worker/tsconfig.json && tsc -p push-worker/test/tsconfig.json",
    "test": "vitest run && npm run test:worker",
    "test:watch": "vitest",
    "test:worker": "vitest run --config push-worker/vitest.config.ts",
    "data": "tsx scripts/fetch-construction-sites.ts",
    "feeds": "tsx scripts/generate-feeds.ts",
    "push:keys": "tsx scripts/generate-vapid-keys.ts",
    "push:secrets:setup": "tsx scripts/configure-push-secrets.ts",
    "push:github:setup": "tsx scripts/configure-github-push.ts",
    "push:send": "tsx scripts/send-push.ts",
    "push:dev": "wrangler dev --config push-worker/wrangler.jsonc",
    "push:deploy": "wrangler deploy --config push-worker/wrangler.jsonc",
    "push:db:init:local": "wrangler d1 execute faecherbagger-push --local --file=push-worker/schema.sql --config push-worker/wrangler.jsonc",
    "push:db:init:remote": "wrangler d1 execute faecherbagger-push --remote --file=push-worker/schema.sql --config push-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@kern-ux-annex/kern-react-kit": "^2.40.0",
    "@kern-ux/native": "^2.7.2",
    "feed": "^6.0.0",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "libsodium-wrappers": "^0.8.4",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "web-push": "^3.6.7",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
