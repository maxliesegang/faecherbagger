{
  "name": "faecherbagger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Understandable view of current and upcoming road construction sites (Baustellen) in the Karlsruhe region.",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p push-worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "tsx scripts/fetch-baustellen.ts",
    "push:keys": "tsx scripts/generate-vapid-keys.ts",
    "push:send": "tsx scripts/send-push.ts",
    "push:dev": "wrangler dev --config push-worker/wrangler.jsonc",
    "push:deploy": "wrangler deploy --config push-worker/wrangler.jsonc",
    "push:db:init:local": "wrangler d1 execute faecherbagger-push --local --file=push-worker/schema.sql --config push-worker/wrangler.jsonc",
    "push:db:init:remote": "wrangler d1 execute faecherbagger-push --remote --file=push-worker/schema.sql --config push-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@kern-ux-annex/kern-react-kit": "^2.40.0",
    "@kern-ux/native": "^2.7.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "web-push": "^3.6.7",
    "wrangler": "^4.114.0"
  }
}
